# Игнорируем файлы .pyc (скомпилированный Python-код)
*.pyc

# Игнорируем папку __pycache__ (кеш Python)
__pycache__/

# Игнорируем виртуальное окружение (если используете venv, virtualenv и т.д.)
venv/
.env/
env/
git add .gitignore
# Игнорируем файлы настроек IDE (PyCharm)
.idea/
.vscode/

# Игнорируем логи и временные файлы
*.log
*.tmp

# Игнорируем файлы данных (например, .csv, .json), если они генерируются кодом
*.csv
*.json